# Dify 1.16.1 console API base. Both forms are accepted:
# https://dify.example.com  or  https://dify.example.com/console/api
DIFY_CONSOLE_API_URL=https://dify.example.com/console/api

# Recommended headless authentication. Enable ADMIN_API_KEY in Dify and set
# the workspace ID whose owner identity should be used.
DIFY_ADMIN_API_KEY=
DIFY_WORKSPACE_ID=

# Alternative short-lived console JWT authentication. Mutating/generator
# endpoints also need the matching CSRF token and cookie name.
DIFY_CONSOLE_ACCESS_TOKEN=
DIFY_CSRF_TOKEN=
DIFY_CSRF_COOKIE_NAME=csrf_token

DIFY_TLS_VERIFY=true
DIFY_HTTP_TIMEOUT=120
DIFY_PREVIEW_TTL_SECONDS=1800

# Optional default model used by Dify's native workflow generator.
DIFY_GENERATOR_MODEL_PROVIDER=
DIFY_GENERATOR_MODEL_NAME=
DIFY_GENERATOR_MODEL_MODE=chat

